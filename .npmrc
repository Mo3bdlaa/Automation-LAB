# Lay node_modules out as real directories rather than symlinks into the store.
#
# Vercel packages a serverless function by tracing files, and refuses a package
# whose files sit behind symlinks: "The framework produced an invalid deployment
# package for a Serverless Function." That bites whenever something has to be
# included by path rather than reached by import - the fonts, and the browser
# that @sparticuz/chromium carries as 67 MB of compressed files in its bin
# directory.
node-linker=hoisted
