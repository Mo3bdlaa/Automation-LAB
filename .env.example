# Postgres connection. Local dev default matches scripts/dev-db.sh.
DATABASE_URL=postgres://automationlab:automationlab@127.0.0.1:5432/automationlab

# Secret used to sign the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Identity provider. "local" = dev credentials provider (see src/lib/identity).
IDENTITY_PROVIDER=local

# Where rendered PDFs are stored. Local dev writes to ./.data/blobs.
BLOB_STORE=local
BLOB_LOCAL_DIR=./.data/blobs

# Chromium binary for the PDF renderer. Leave unset to auto-detect
# (Playwright's registry, PLAYWRIGHT_BROWSERS_PATH, or @sparticuz/chromium).
# CHROMIUM_EXECUTABLE_PATH=/opt/pw-browsers/chromium

# Public origin of the app, used for absolute links in PDFs.
APP_ORIGIN=http://localhost:3000
