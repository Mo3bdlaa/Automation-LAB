{
  "name": "automation-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Automation Lab \u2014 practice sandbox for the Document Understanding / RPA course",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-corpus.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "render:po": "tsx scripts/render-po.ts",
    "worker": "tsx scripts/worker.ts",
    "serve:prod": "scripts/serve-prod.sh",
    "api:smoke": "node scripts/api-smoke.mjs",
    "challenge:smoke": "node scripts/challenge-smoke.mjs",
    "ocr:ladder": "tsx scripts/ocr-ladder.ts",
    "pdd": "tsx scripts/build-pdd.ts",
    "pdd:figures": "tsx scripts/render-pdd-samples.ts && node scripts/capture-pdd-figures.mjs",
    "bot:smoke": "node scripts/bot-credential-smoke.mjs",
    "blob:check": "tsx scripts/blob-check.ts",
    "scorer:proof": "tsx scripts/scorer-proof.ts",
    "pdf:proof": "tsx scripts/pdf-proof.ts",
    "deck:preview": "tsx scripts/deck-preview.ts",
    "shell:shots": "node scripts/shell-shots.mjs",
    "ids:check": "node scripts/duplicate-ids.mjs"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.4",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
